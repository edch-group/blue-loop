{
  "name": "blue-loop",
  "productName": "Blue Loop",
  "version": "0.1.0",
  "description": "Blue Loop \u2014 a deck-building duel of warring solar civilisations, by Coronal Mass Games.",
  "author": "Coronal Mass Games",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "simulate": "vite-node scripts/simulate.ts",
    "simulate:pool": "vite-node scripts/simulate-pool.ts",
    "duel": "vite-node scripts/duel.ts",
    "deck-search": "vite-node scripts/deck-search.ts",
    "dominated": "vite-node scripts/dominated.ts",
    "sky": "node scripts/render-sky.mjs",
    "voice": "node scripts/process-voice.mjs",
    "electron:dev": "vite build && electron .",
    "electron:build": "vite build && electron-builder --dir",
    "dist": "vite build && electron-builder",
    "ios:sync": "npm run build && cap sync ios",
    "ios:open": "npm run ios:sync && cap open ios",
    "server": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy"
  },
  "build": {
    "appId": "com.coronalmassgames.blueloop",
    "productName": "Blue Loop",
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "dir"
    },
    "linux": {
      "target": "dir"
    },
    "mac": {
      "target": "dir"
    }
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@cloudflare/workers-types": "^5.20260930.2",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vite-node": "^6.0.0",
    "vitest": "^5.0.2",
    "wrangler": "^4.145.0"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/screen-orientation": "^8.0.1",
    "@fontsource/exo-2": "^5.3.0",
    "@fontsource/orbitron": "^5.3.0"
  }
}
