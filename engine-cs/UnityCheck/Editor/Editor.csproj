<Project Sdk="Microsoft.NET.Sdk">
  <!-- unity/Assets/Editor (Unity's Assembly-CSharp-Editor): the editor's build scripts, which see the game's scripts too. -->
  <PropertyGroup>
    <AssemblyName>Assembly-CSharp-Editor</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../../unity/Assets/Editor/**/*.cs" />
    <ProjectReference Include="../Client/Client.csproj" />
    <ProjectReference Include="../Stubs/UnityStubs.csproj" />
    <ProjectReference Include="../EditorStubs/UnityEditorStubs.csproj" />
    <ProjectReference Include="../../BlueLoop.Engine.csproj" />
    <ProjectReference Include="../../Models/BlueLoop.Models.csproj" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>
</Project>
